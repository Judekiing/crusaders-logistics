APP_NAME="Logistics Flix"
APP_ENV=local
APP_KEY=base64:mP2aK9c8B4d1F6h3J7k0L5m8N2p4Q6r8T0v2X4z6B8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default SQLite for zero-setup instant local running
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Optional MySQL for cPanel / production:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=logisticsflix_db
# DB_USERNAME=cpanel_dbuser
# DB_PASSWORD=cpanel_dbpassword

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Email Settings: Set MAIL_MAILER=smtp for live email delivery, or 'log' for audit testing
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.logisticsflix.org
MAIL_PORT=587
MAIL_USERNAME=dispatch@logisticsflix.org
MAIL_PASSWORD=secret
MAIL_ENCRYPTION=tls
